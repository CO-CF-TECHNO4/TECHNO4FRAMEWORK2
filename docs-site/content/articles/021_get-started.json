 \\u0449\\u043e\\u0431 \\u044f\\u043a\\u043d\\u0430\\u0439\\u0448\\u0432\\u0438\\u0434\\u0448\\u0435 \\u043f\\u043e\\u043a\\u0430\\u0437\\u0430\\u0442\\u0438 \\u0440\\u043e\\u0431\\u043e\\u0447\\u0438\\u0439 \\u043f\\u0440\\u043e\\u0442\\u043e\\u0442\\u0438\\u043f \\u043f\\u0440\\u043e\\u0433\\u0440\\u0430\\u043c\\u0438, \\u044f\\u043a\\u0449\\u043e \\u0432\\u0430\\u043c \\u0446\\u0435 \\u0437\\u043d\\u0430\\u0434\\u043e\\u0431\\u0438\\u0442\\u044c\\u0441\\u044f.\",\"margin\":\"default\",\"text_style\":\"large\"},\"name\":\"\\u041e\\u043f\\u0438\\u0441\"},{\"type\":\"text\",\"props\":{\"column_breakpoint\":\"m\",\"content\":\"\\u041e\\u0441\\u043d\\u043e\\u0432\\u043d\\u0438\\u0439 \\u043f\\u0456\\u0434\\u0445\\u0456\\u0434 Techno4 Framework \\u043f\\u043e\\u043b\\u044f\\u0433\\u0430\\u0454 \\u0432 \\u0442\\u043e\\u043c\\u0443, \\u0449\\u043e\\u0431 \\u043d\\u0430\\u0434\\u0430\\u0442\\u0438 \\u0432\\u0430\\u043c \\u043c\\u043e\\u0436\\u043b\\u0438\\u0432\\u0456\\u0441\\u0442\\u044c \\u043b\\u0435\\u0433\\u043a\\u043e \\u0442\\u0430 \\u0437\\u0440\\u043e\\u0437\\u0443\\u043c\\u0456\\u043b\\u043e \\u0441\\u0442\\u0432\\u043e\\u0440\\u044e\\u0432\\u0430\\u0442\\u0438 \\u043f\\u0440\\u043e\\u0433\\u0440\\u0430\\u043c\\u0438 \\u0434\\u043b\\u044f iOS \\u0442\\u0430 Android \\u0437\\u0430 \\u0434\\u043e\\u043f\\u043e\\u043c\\u043e\\u0433\\u043e\\u044e HTML, CSS \\u0442\\u0430 JavaScript.\",\"margin\":\"default\",\"text_style\":\"large\"},\"name\":\"\\u041e\\u043f\\u0438\\u0441\"},{\"type\":\"table\",\"props\":{\"content_style\":\"text-small\",\"image_svg_color\":\"emphasis\",\"link_fullwidth\":true,\"link_size\":\"small\",\"link_style\":\"default\",\"link_text\":\"\",\"meta_style\":\"text-meta\",\"show_content\":true,\"show_image\":true,\"show_link\":true,\"show_meta\":true,\"show_title\":true,\"table_head_content\":\"\\u041e\\u043f\\u0438\\u0441\",\"table_head_image\":\"\\u0417\\u043e\\u0431\\u0440\\u0430\\u0436\\u0435\\u043d\\u043d\\u044f\",\"table_head_link\":\"\\u042